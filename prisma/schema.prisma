generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum ApplicationStatus {
  NEW
  REVIEWING
  ACCEPTED
  DECLINED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Page {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  contentHtml    String    @db.Text
  seoTitle       String?
  seoDescription String?
  seoImage       String?
  published      Boolean   @default(false)
  sections       Section[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Section {
  id           String   @id @default(cuid())
  pageId       String?
  page         Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type         String
  title        String?
  subtitle     String?
  contentHtml  String?  @db.Text
  imageUrl     String?
  videoUrl     String?
  buttonText   String?
  buttonUrl    String?
  sortOrder    Int      @default(0)
  settingsJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([pageId, sortOrder])
}

model BlogPost {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  excerpt        String?  @db.Text
  contentHtml    String   @db.Text
  featuredImage  String?
  category       String?
  tags           String[] @default([])
  seoTitle       String?
  seoDescription String?
  seoImage       String?
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Product {
  id                  String   @id @default(cuid())
  title               String
  slug                String   @unique
  price               Decimal  @db.Decimal(10, 2)
  shortDescription    String?  @db.Text
  longDescriptionHtml String?  @db.Text
  imageUrl            String?
  galleryJson         Json?
  productType         String   @default("service")
  downloadFileUrl     String?
  seoTitle            String?
  seoDescription      String?
  seoImage            String?
  published           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PodcastEpisode {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  youtubeUrl      String?
  spotifyUrl      String?
  appleUrl        String?
  guestName       String?
  descriptionHtml String?  @db.Text
  imageUrl        String?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InterviewApplication {
  id                 String            @id @default(cuid())
  fullName           String
  email              String
  phone              String?
  whatsapp           String?
  telegram           String?
  facebook           String?
  website            String?
  selectedPackage    String?
  shortBio           String?           @db.Text
  story              String            @db.Text
  humanityService    String?           @db.Text
  desiredImpact      String?           @db.Text
  serviceOrBookLinks String?           @db.Text
  preferredTime      String?
  status             ApplicationStatus @default(NEW)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model QuizQuestion {
  id          String   @id @default(cuid())
  question    String
  type        String   @default("text")
  optionsJson Json?
  required    Boolean  @default(false)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id                  String   @id @default(cuid())
  siteName            String   @default("Threads of Enlightenment")
  siteDescription     String?  @db.Text
  logoUrl             String?
  faviconUrl          String?
  googleAnalytics     String?
  googleSearchConsole String?
  facebook            String?
  instagram           String?
  youtube             String?
  spotify             String?
  tiktok              String?
  telegram            String?
  whatsapp            String?
  twitter             String?
  linkedin            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
